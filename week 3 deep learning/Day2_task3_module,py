import torch
import torch.nn as nn

class MLP(nn.Module):
    def __init__(self, in_dim, hidden, out_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(in_dim, hidden),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(hidden, out_dim),
        )

    def forward(self, x):
        return self.net(x)

model = MLP(30, 16, 1)
print(model)
print("Parameters:", sum(p.numel() for p in model.parameters()))

emb = nn.Embedding(10, 4)
idx = torch.tensor([1, 3, 5])
print("Embedding output shape:", emb(idx).shape)

bn = nn.BatchNorm1d(16)
out = bn(torch.randn(8, 16))
print("BN mean per feature:", out.mean(0))
print("BN std per feature:", out.std(0))

# model.train(): Dropout is active, BatchNorm uses batch statistics.
# model.eval(): Dropout is off, BatchNorm uses running averages.